---
import Layout from '../../layouts/Layout.astro'
import SobreMi from '../../components/SobreMi_en.astro'
import Proyectos from '../../components/Proyectos_en.astro'
const lang = 'en'
const title = 'Accessible website designer and developer.'
const description = 'Web designer and developer specialising in accessible, user-friendly websites built with Astro, WordPress, PrestaShop, Joomla or fully custom code.'
const canonical = 'en/'
---

<Layout
